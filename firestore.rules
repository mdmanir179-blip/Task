rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Staff & Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Operational Daily Tasks
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Company Directory Personnel
    match /companyPersons/{personId} {
      allow read, write: if true;
    }

    // Important Operational Forms
    match /importantForms/{formId} {
      allow read, write: if true;
    }
  }
}
